# SARTHI-ETA API — demo configuration (copy to .env)
PORT=8100
HOST=0.0.0.0

# Prediction engine: sarthi-blend (default, back-tested) | baseline (spec §6 heuristic)
MODEL_NAME=sarthi-blend

# Simulator clock
SIM_SPEED=2.0          # simulated minutes per real second
SECTION_REAL_S=15      # real seconds per track section
SNAPSHOT_REAL_S=5      # prediction snapshot cadence for learning store

# Auth for ingestion endpoints (/api/v1/data/*)
INGEST_API_KEY=sarthi-demo-key

# Rate limiting
RATE_LIMIT_PER_MIN=300

# Hero-train demo arrival time (spec §20)
DEMO_ARRIVAL_HHMM=10:30
